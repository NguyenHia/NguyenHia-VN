<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" 
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <key>PayloadContent</key>
    <array>
        <dict>
            <key>FullScreen</key>
            <true/>
            <key>Icon</key>
            <data>
            <!-- Optional: Base64 encoded icon -->
            </data>
            <key>IsRemovable</key>
            <true/>
            <key>Label</key>
            <string>NguyenHia App</string>
            <key>PayloadDescription</key>
            <string>Web Clip for NguyenHia</string>
            <key>PayloadDisplayName</key>
            <string>NguyenHia Web App</string>
            <key>PayloadIdentifier</key>
            <string>com.nguyenhia.webclip</string>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadUUID</key>
            <string>12345678-ABCD-1234-ABCD-1234567890AB</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>URL</key>
            <string>https://nguyenhia-vn.netlify.app</string>
        </dict>
    </array>

    <key>PayloadDisplayName</key>
    <string>NguyenHia Profile</string>
    <key>PayloadIdentifier</key>
    <string>com.nguyenhia.profile</string>
    <key>PayloadUUID</key>
    <string>ABCDEF12-3456-7890-ABCD-EF1234567890</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

</dict>
</plist>
